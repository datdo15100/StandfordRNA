\begin{algorithm}
\caption{Hybrid Model (PeakDetect))}
\label{alg}
\begin{algorithmic}[1]
\REQUIRE Training scenarios $S_1, ..., S_n$, parameter space $\Theta$
\ENSURE Optimized hybrid model $M_{hybrid}$
\STATE \textbf{Stage 1: Parameter Optimization}
\FOR{each $\theta \in \Theta$}
\FOR{each $S_i$}
\STATE $features_i \leftarrow$ HeuristicAlgorithm($S_i$, $\theta$)
\STATE $F1_i \leftarrow$ Evaluate($features_i$, ground_truth$i$)
\ENDFOR
\STATE $F1{avg} \leftarrow$ mean($F1_1, ..., F1_n$)
\ENDFOR
\STATE $\theta^* \leftarrow \arg\max_\theta F1_{avg}$
\STATE \textbf{Stage 2: Feature Generation}
\FOR{each $S_i$}
\STATE $features_i^* \leftarrow$ HeuristicAlgorithm($S_i$, $\theta^$)
\ENDFOR
\STATE \textbf{Stage 3: LSTM Training}
\STATE $M_{hybrid} \leftarrow$ TrainLSTM($features^$, architecture)
\RETURN $M_{hybrid}$
\end{algorithmic}
\end{algorithm}

