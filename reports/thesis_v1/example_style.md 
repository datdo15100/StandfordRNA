\begin{algorithm}
\caption{Heuristic Peak Detection}
\label{alg}
\begin{algorithmic}[1]
\REQUIRE Throughput data $T$, parameters $(W_l, W_s, \tau, \theta)$
\ENSURE Congestion classification $C$ and feature set $F$
\STATE Initialize arrays: $C$, $L_{max}$, $S_{peak}$, $S_{count}$, $P_{ratio}$
\STATE $T_f \leftarrow$ Apply median filter to $T$ if enabled
\FOR{each long window of size $W_l$ in $T$}
\STATE $p_l \leftarrow \max(T_f^{window})$
\STATE $L_{max}^{window} \leftarrow p_l$
\FOR{each short bin of size $W_s$ within long window}
\STATE $p_s \leftarrow \max(T^{bin})$
\STATE $S_{peak}^{bin} \leftarrow p_s$
\STATE $threshold \leftarrow (1 - \tau) \times p_l$
\STATE $count \leftarrow \sum(T^{bin} \geq threshold)$
\STATE $S_{count}^{bin} \leftarrow count$
\IF{$count > \theta$}
\STATE $C^{bin} \leftarrow 1$
\ELSE
\STATE $C^{bin} \leftarrow 0$
\ENDIF
\ENDFOR
\ENDFOR
\STATE Calculate $P_{ratio} \leftarrow S_{peak} / L_{max}$ where $L_{max} > 0$
% \STATE Handle any NaN or Inf values in all arrays
\STATE $F \leftarrow {L_{max}, T_f, P_{ratio}, S_{count}, S_{peak}}$
\RETURN $C$ and $F$
\end{algorithmic}
\end{algorithm}

